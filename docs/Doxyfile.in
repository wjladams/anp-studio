# Doxygen configuration for cppanp GUI (generated by CMake).

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
CREATE_SUBDIRS         = NO

INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/gui/document.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/gui/mainwindow.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/gui/canvas/network_canvas.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/gui/panels/structure_panel.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/gui/panels/pairwise_panel.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/gui/panels/results_panel.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md
RECURSIVE              = NO
FILE_PATTERNS          = *.hpp *.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES

MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

# Qt macros (headers only; MOC not required for doc generation).
PREDEFINED             = Q_OBJECT \
                         Q_SLOTS= \
                         Q_SIGNALS=public \
                         Q_PROPERTY(x)= \
                         Q_DECLARE_FLAGS(x,y)= \
                         Q_DECLARE_METATYPE(x)= \
                         Q_ENUM(x)= \
                         Q_FLAG(x)=

HAVE_DOT               = NO
