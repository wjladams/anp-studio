# Copy to .env and fill in values from Google Cloud → OAuth Desktop client.
# Never commit .env (it is gitignored).
#
# Either name works; ANPSTUDIO_* is preferred for clarity.

ANPSTUDIO_GOOGLE_CLIENT_ID=
ANPSTUDIO_GOOGLE_CLIENT_SECRET=

# Also accepted (same meaning):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
