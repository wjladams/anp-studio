/* ANP Studio — light productivity UI
 * Palette inspired by Gmail / Slack / Teams / Grok light modes:
 *   canvas/page  #ffffff
 *   chrome/side  #f6f8fc
 *   border       #dadce0
 *   text         #202124
 *   muted        #5f6368
 *   accent       #1a73e8
 *   selected     #e8f0fe
 *   hover        #f1f3f4
 */

* {
  font-family: "Ubuntu", "Cantarell", "Noto Sans", sans-serif;
  font-size: 13px;
  color: #202124;
}

QMainWindow,
QDialog,
QWidget {
  background-color: #ffffff;
  color: #202124;
}

QToolTip {
  background-color: #202124;
  color: #ffffff;
  border: none;
  padding: 6px 8px;
  border-radius: 4px;
}

/* —— Menu —— */
QMenuBar {
  background-color: #ffffff;
  color: #202124;
  border-bottom: 1px solid #dadce0;
  padding: 2px 6px;
  spacing: 2px;
}

QMenuBar::item {
  background-color: transparent;
  color: #202124;
  padding: 6px 10px;
  border-radius: 4px;
  margin: 2px 1px;
}

QMenuBar::item:selected {
  background-color: #e8f0fe;
  color: #1967d2;
}

QMenuBar::item:pressed {
  background-color: #d2e3fc;
}

QMenu {
  background-color: #ffffff;
  color: #202124;
  border: 1px solid #dadce0;
  border-radius: 8px;
  padding: 4px;
}

QMenu::item {
  background-color: transparent;
  color: #202124;
  padding: 7px 28px 7px 12px;
  border-radius: 4px;
  margin: 1px 2px;
}

QMenu::item:selected {
  background-color: #e8f0fe;
  color: #1967d2;
}

QMenu::separator {
  height: 1px;
  background-color: #dadce0;
  margin: 4px 8px;
}

/* —— Toolbar —— */
QToolBar {
  background-color: #ffffff;
  color: #202124;
  border: none;
  border-bottom: 1px solid #dadce0;
  spacing: 4px;
  padding: 6px 8px;
}

QToolBar::separator {
  background-color: #dadce0;
  width: 1px;
  margin: 4px 6px;
}

QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px 10px;
  color: #3c4043;
}

QToolButton:hover {
  background-color: #f1f3f4;
  border-color: #dadce0;
  color: #202124;
}

QToolButton:pressed,
QToolButton:checked {
  background-color: #e8f0fe;
  border-color: #aecbfa;
  color: #1967d2;
}

/* —— Stage tabs —— */
QPushButton#stageTab {
  background-color: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  padding: 8px 14px;
  margin: 0 2px;
  color: #5f6368;
  font-weight: 600;
}

QPushButton#stageTab:hover {
  color: #202124;
  background-color: #f1f3f4;
  border-bottom-color: #dadce0;
}

QPushButton#stageTab:checked {
  color: #1a73e8;
  background-color: transparent;
  border-bottom: 2px solid #1a73e8;
}

/* —— Breadcrumb —— */
QWidget#breadcrumbBar {
  background-color: transparent;
}

QLabel#breadcrumbCaption,
QLabel#breadcrumbSep {
  color: #5f6368;
  background-color: transparent;
}

QLabel#breadcrumbCurrent {
  color: #202124;
  font-weight: 600;
  background-color: transparent;
  padding: 4px 2px;
}

QLabel#scopeModeChipEditable {
  color: #174ea6;
  background-color: #e8f0fe;
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
}

QLabel#scopeModeChipReadonly {
  color: #5f6368;
  background-color: #f1f3f4;
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
}

QTreeWidget#analysisNav {
  background-color: #f8f9fa;
  border: none;
  border-right: 1px solid #dadce0;
  padding: 8px 4px;
  outline: none;
  show-decoration-selected: 1;
}

QTreeWidget#analysisNav::item {
  color: #1a73e8;
  font-weight: 600;
  padding: 4px 6px;
  border-radius: 4px;
  min-height: 22px;
}

QTreeWidget#analysisNav::item:hover {
  background-color: #e8f0fe;
  color: #1967d2;
}

QTreeWidget#analysisNav::item:selected {
  background-color: #d2e3fc;
  color: #174ea6;
}

QTreeWidget#analysisNav::branch {
  background-color: transparent;
}

QWidget#judgmentSelector {
  background-color: #f8f9fa;
  border: none;
  border-right: 1px solid #dadce0;
}

QLabel#selectorSection {
  color: #1a73e8;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-top: 8px;
  background: transparent;
}

QWidget#judgmentSelector QComboBox {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 4px;
  padding: 4px 6px;
  min-height: 24px;
}

QWidget#judgmentSelector QComboBox:hover {
  border-color: #aecbfa;
}

QWidget#judgmentSelector QComboBox:focus {
  border-color: #1a73e8;
}

QPushButton#breadcrumbLink {
  background-color: transparent;
  border: none;
  border-radius: 4px;
  padding: 4px 6px;
  color: #1a73e8;
  font-weight: 600;
  min-height: 0;
}

QPushButton#breadcrumbLink:hover {
  background-color: #e8f0fe;
  border: none;
  color: #1967d2;
}

QPushButton#breadcrumbLink:pressed {
  background-color: #d2e3fc;
  border: none;
}

QPushButton#selectorToggle {
  background-color: transparent;
  border: 1px solid #dadce0;
  border-radius: 6px;
  padding: 5px 12px;
  color: #3c4043;
  min-height: 22px;
}

QPushButton#selectorToggle:hover {
  background-color: #f1f3f4;
  border-color: #bdc1c6;
}

QPushButton#selectorToggle:checked {
  background-color: #e8f0fe;
  border-color: #aecbfa;
  color: #1967d2;
  font-weight: 600;
}

QLabel#selectorCaption {
  color: #5f6368;
  background-color: transparent;
  font-weight: 600;
}

QLabel#selectorMuted {
  color: #5f6368;
  background-color: transparent;
}

/* —— Scope rail (Judgments) —— */
QLabel#sessionActivePill {
  background-color: #e8f0fe;
  color: #174ea6;
  font-weight: 600;
  border-radius: 6px;
  padding: 6px 8px;
}

QWidget#questionnaireRow {
  background-color: #ffffff;
  border: 1px solid #e8eaed;
  border-radius: 6px;
}

QPushButton#saatyScaleBtn {
  border-radius: 4px;
  padding: 0;
  margin: 0;
  font-weight: 600;
  min-width: 28px;
  max-width: 28px;
  min-height: 28px;
  max-height: 28px;
}

QToolButton#canvasAddClusterBtn {
  background-color: #1a73e8;
  color: #ffffff;
  border: none;
  border-radius: 18px;
  font-size: 20px;
  font-weight: 700;
}

QToolButton#canvasAddClusterBtn:hover {
  background-color: #1765cc;
}

QToolButton#canvasAddClusterBtn:pressed {
  background-color: #1557b0;
}

/* —— Structure Normal | Connection mode bar —— */
QWidget#structureModeBar {
  background-color: #f8f9fa;
  border-bottom: 1px solid #dadce0;
}

QPushButton#structureModeBtnNormal,
QPushButton#structureModeBtnConnection {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  padding: 5px 16px;
  min-height: 22px;
  color: #5f6368;
  font-weight: 600;
}

QPushButton#structureModeBtnNormal {
  border-top-left-radius: 6px;
  border-bottom-left-radius: 6px;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

QPushButton#structureModeBtnConnection {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
  margin-left: -1px;
}

QPushButton#structureModeBtnNormal:hover,
QPushButton#structureModeBtnConnection:hover {
  background-color: #f1f3f4;
  color: #202124;
}

QPushButton#structureModeBtnNormal:checked,
QPushButton#structureModeBtnConnection:checked {
  background-color: #e8f0fe;
  border-color: #1a73e8;
  color: #1967d2;
}

/* —— Buttons —— */
QPushButton {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 6px;
  padding: 6px 12px;
  color: #202124;
  min-height: 22px;
}

QPushButton:hover {
  background-color: #f1f3f4;
  border-color: #bdc1c6;
  color: #202124;
}

QPushButton:pressed {
  background-color: #e8eaed;
}

QPushButton:checked {
  background-color: #e8f0fe;
  border-color: #aecbfa;
  color: #1967d2;
}

QPushButton:disabled {
  color: #9aa0a6;
  background-color: #f8f9fa;
  border-color: #e8eaed;
}

QPushButton:default,
QPushButton#primaryButton {
  background-color: #1a73e8;
  border-color: #1a73e8;
  color: #ffffff;
  font-weight: 600;
}

QPushButton:default:hover,
QPushButton#primaryButton:hover {
  background-color: #1765cc;
  border-color: #1765cc;
  color: #ffffff;
}

QPushButton:default:pressed,
QPushButton#primaryButton:pressed {
  background-color: #1557b0;
  color: #ffffff;
}

/* —— Inputs —— */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 6px;
  padding: 5px 8px;
  color: #202124;
  selection-background-color: #d2e3fc;
  selection-color: #202124;
  min-height: 22px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
  border: 1px solid #1a73e8;
  background-color: #ffffff;
}

QComboBox::drop-down {
  border: none;
  width: 22px;
  background-color: transparent;
}

QComboBox::down-arrow {
  width: 0;
  height: 0;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 5px solid #5f6368;
  margin-right: 8px;
}

QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #202124;
  border: 1px solid #dadce0;
  border-radius: 6px;
  selection-background-color: #e8f0fe;
  selection-color: #1967d2;
  outline: none;
  padding: 2px;
}

QCheckBox {
  spacing: 8px;
  color: #202124;
  background-color: transparent;
}

QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #dadce0;
  border-radius: 4px;
  background-color: #ffffff;
}

QCheckBox::indicator:hover {
  border-color: #1a73e8;
}

QCheckBox::indicator:checked {
  background-color: #1a73e8;
  border-color: #1a73e8;
}

/* —— Tables / trees / lists —— */
QTreeView,
QTableView,
QListView,
QTableWidget,
QTreeWidget,
QListWidget,
QAbstractItemView {
  background-color: #ffffff;
  color: #202124;
  border: 1px solid #dadce0;
  border-radius: 8px;
  outline: none;
  gridline-color: #f1f3f4;
  selection-background-color: #e8f0fe;
  selection-color: #1967d2;
  alternate-background-color: #f8f9fa;
}

QHeaderView {
  background-color: #f6f8fc;
}

QHeaderView::section {
  background-color: #f6f8fc;
  color: #5f6368;
  border: none;
  border-right: 1px solid #dadce0;
  border-bottom: 1px solid #dadce0;
  padding: 7px 10px;
  font-weight: 600;
}

QHeaderView::section:last {
  border-right: none;
}

QTreeView::item,
QTableView::item,
QListView::item {
  padding: 4px;
  min-height: 24px;
  color: #202124;
  background-color: transparent;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
  background-color: #f1f3f4;
  color: #202124;
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
  background-color: #e8f0fe;
  color: #1967d2;
}

/* —— Tabs —— */
QTabWidget::pane {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
  top: -1px;
}

QTabBar::tab {
  background-color: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 14px;
  margin-right: 2px;
  color: #5f6368;
  font-weight: 600;
}

QTabBar::tab:hover {
  color: #202124;
  background-color: #f1f3f4;
}

QTabBar::tab:selected {
  color: #1a73e8;
  border-bottom: 2px solid #1a73e8;
  background-color: transparent;
}

/* —— Splitter / scroll / status —— */
QSplitter::handle {
  background-color: #dadce0;
}

QSplitter::handle:horizontal {
  width: 1px;
  margin: 0 2px;
}

QSplitter::handle:vertical {
  height: 1px;
  margin: 2px 0;
}

QSplitter::handle:hover {
  background-color: #1a73e8;
}

QScrollBar:vertical {
  background-color: #ffffff;
  width: 10px;
  margin: 2px;
}

QScrollBar::handle:vertical {
  background-color: #dadce0;
  border-radius: 5px;
  min-height: 28px;
}

QScrollBar::handle:vertical:hover {
  background-color: #bdc1c6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
  height: 0;
}

QScrollBar:horizontal {
  background-color: #ffffff;
  height: 10px;
  margin: 2px;
}

QScrollBar::handle:horizontal {
  background-color: #dadce0;
  border-radius: 5px;
  min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #bdc1c6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
  width: 0;
}

QStatusBar {
  background-color: #ffffff;
  border-top: 1px solid #dadce0;
  color: #5f6368;
}

QStatusBar::item {
  border: none;
}

QLabel {
  background-color: transparent;
  color: #202124;
}

QGroupBox {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
  margin-top: 10px;
  padding-top: 8px;
  font-weight: 600;
  color: #202124;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #5f6368;
  background-color: #ffffff;
}

QStackedWidget,
QScrollArea,
QAbstractScrollArea {
  background-color: #ffffff;
  color: #202124;
  border: none;
}

QGraphicsView {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
}

QMessageBox,
QInputDialog,
QFileDialog {
  background-color: #ffffff;
  color: #202124;
}

/* —— Ratings Option D scale block —— */
QFrame#ratingsScaleBlock {
  background-color: #eef1f4;
  border: 1px solid #c5cad1;
  border-radius: 8px;
}

QWidget#ratingsScaleRow {
  background-color: #ffffff;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
  border-bottom-left-radius: 7px;
  border-bottom-right-radius: 7px;
}

QFrame#ratingsScaleBlock[advancedOpen="true"] QWidget#ratingsScaleRow {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom: 1px solid #dadce0;
}

QWidget#ratingsAdvancedPop {
  background-color: #ffffff;
  border-top: 2px solid #1a73e8;
  border-bottom-left-radius: 7px;
  border-bottom-right-radius: 7px;
}

QLabel#ratingsModeHint {
  color: #5f6368;
  font-style: italic;
  font-size: 12px;
  background: transparent;
  border: none;
  padding: 0 2px;
}

QLabel#ratingsFieldLabel,
QLabel#ratingsVotesLabel {
  color: #5f6368;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: transparent;
}

QToolButton#ratingsAdvancedBtn {
  color: #1a73e8;
  font-weight: 600;
  background: transparent;
  border: none;
  padding: 4px 6px;
}

QToolButton#ratingsAdvancedBtn:hover {
  background-color: #e8f0fe;
  border-radius: 4px;
}

QLabel#ratingsHeader {
  font-weight: 600;
  font-size: 14px;
  color: #202124;
}

/* —— Researcher —— */
QLabel#researcherCaption {
  font-weight: 700;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #5f6368;
  margin-top: 2px;
}

QWidget#researcherRightRail,
QWidget#researcherSideHost {
  background-color: #f6f8fc;
}

QScrollArea#researcherSideScroll {
  background-color: #f6f8fc;
  border: none;
}

QListWidget#researcherStarters {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
  outline: none;
  padding: 0px;
  font-family: "Ubuntu Mono", "Consolas", "Courier New", monospace;
  font-size: 12px;
  color: #202124;
}

QListWidget#researcherStarters::item {
  padding: 6px 10px;
  border-bottom: 1px solid #dadce0;
}

QListWidget#researcherStarters::item:selected,
QListWidget#researcherStarters::item:hover {
  background-color: #f1f3f4;
  color: #202124;
}

QTextBrowser#researcherBindings {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
  padding: 2px;
  color: #5f6368;
  font-family: "Ubuntu Mono", "Consolas", "Courier New", monospace;
  font-size: 12px;
}

QLabel#researcherIntro {
  color: #5f6368;
}

QLabel#researcherPrompt {
  font-family: "Ubuntu Mono", "Consolas", "Courier New", monospace;
  font-weight: 600;
  color: #1a73e8;
}

QLabel#researcherCellCmd {
  font-family: "Ubuntu Mono", "Consolas", "Courier New", monospace;
  font-weight: 600;
  color: #202124;
}

QFrame#researcherCell {
  background-color: #ffffff;
  border: 1px solid #dadce0;
  border-radius: 8px;
}

QWidget#researcherTabRow {
  background-color: #f6f8fc;
  border-bottom: 1px solid #dadce0;
}

QToolButton#researcherMenuBtn,
QToolButton#researcherAddTabBtn {
  color: #5f6368;
  font-weight: 600;
  font-size: 14px;
  padding: 4px 8px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
}

QToolButton#researcherMenuBtn:hover,
QToolButton#researcherAddTabBtn:hover {
  background-color: #f1f3f4;
  border-color: #dadce0;
  color: #202124;
}

QToolButton#researcherAddTabBtn {
  color: #1a73e8;
  font-size: 16px;
}

/* Browser-style notebook tabs */
QTabBar#researcherTabBar {
  background: transparent;
  qproperty-drawBase: 0;
}

QTabBar#researcherTabBar::tab {
  background-color: #f1f3f4;
  color: #5f6368;
  border: 1px solid #dadce0;
  border-bottom: none;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  padding: 7px 22px 7px 12px;
  margin-right: 2px;
  min-width: 4.5em;
  max-width: 10em;
  font-weight: 600;
}

QTabBar#researcherTabBar::tab:selected {
  background-color: #ffffff;
  color: #202124;
  margin-bottom: -1px;
  padding-bottom: 8px;
}

QTabBar#researcherTabBar::tab:hover:!selected {
  background-color: #e8eaed;
  color: #202124;
}

QTabBar#researcherTabBar::close-button {
  subcontrol-position: right;
  margin-right: 4px;
}

QTabBar#researcherTabBar::close-button:hover {
  background-color: #dadce0;
  border-radius: 3px;
}

